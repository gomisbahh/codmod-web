# =========================================================================
# Google Codmod Web Wrapper - Example Environment Configuration
# Copy this file to .env and configure the values for your local environment
# =========================================================================

# Server Configuration
PORT=8080
HOST=127.0.0.1
NODE_ENV=development

# Application-Level Authentication
# Set to "true" to require passcode authentication on the dashboard
APP_AUTH_ENABLED=true
APP_PASSWORD=MySecurePasscode123

# Ephemeral/Persistent Session Signing Secret (use a strong 64-character hex string in production)
SESSION_SECRET=ReplaceWithYourSecureHexSecretKey32or64CharsLong

# Google Cloud Storage Target Bucket
# When running locally without GCP credentials, reports are saved to ./mock-storage/
GCS_BUCKET_NAME=codmod-output
